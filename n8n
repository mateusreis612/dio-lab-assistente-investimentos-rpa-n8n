    {
      "parameters": {
        "jsCode": "const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];\n\nconst clientes = $('Webhook').first().json.body.clientes || [];\nconst produtos = $('Code in JavaScript').all().map(i => i.json);\n\nconst normaliza = (t) => String(t || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n\nconst resultado = clientes.map(c => {\n  const nome = c.nome || '';\n  const perfil = normaliza(c.perfil);\n  let saldoNum = 0;\n  if (c.saldo) {\n    const limpo = String(c.saldo).replace(/[^0-9,]+/g, '').replace(',', '.');\n    saldoNum = parseFloat(limpo) || 0;\n  }\n\n  const elegiveis = produtos.filter(p => normaliza(p.perfil) === perfil && Number(p.minimo) <= saldoNum);\n  const escolhido = elegiveis.length ? elegiveis.map(p => p.produto + ' (' + p.rentabilidade + ')').join(', ') : 'Nenhum produto disponivel para o saldo atual';\n  const motivo = elegiveis.length\n    ? 'Produtos do perfil ' + c.perfil + ' com aplicacao minima compativel com o seu saldo.'\n    : 'O saldo atual e menor que o minimo dos produtos do perfil ' + c.perfil + '.';\n\n  const mensagens = [\n    'Ola ' + nome + ', separamos opcoes alinhadas ao seu perfil ' + c.perfil + '.',\n    nome + ', com base no seu perfil e saldo, estas sao as melhores opcoes para voce.',\n    'Opcoes escolhidas especialmente para voce, ' + nome + '.'\n  ];\n\n  return {\n    nome: nome,\n    email: c.email || '',\n    perfil: c.perfil || '',\n    saldo: saldoNum,\n    escolhido: escolhido,\n    motivo: motivo,\n    mensagem: pick(mensagens)\n  };\n});\n\nreturn resultado.map(r => ({ json: r }));"
      },
