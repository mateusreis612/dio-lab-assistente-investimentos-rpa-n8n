    {
      "parameters": {
        "jsCode": "const returnData = [];\n\n// O HTTP Request geralmente coloca a resposta em texto na propriedade \"data\"\n// Caso o seu campo se chame de outra forma, altere \"item.json.data\" abaixo.\nfor (const item of $input.all()) {\n    const csvText = item.json.data;\n\n    if (!csvText) continue;\n\n    // Divide o texto em linhas e remove espaços ou linhas vazias no final\n    const lines = csvText.trim().split('\\n');\n    \n    // Altere para ';' se o seu CSV for separado por ponto e vírgula\n    const separador = ','; \n    \n    // Extrai e limpa os cabeçalhos (primeira linha do CSV)\n    const headers = lines[0].split(separador).map(header => header.trim());\n\n    for (let i = 1; i < lines.length; i++) {\n        const currentLine = lines[i].split(separador);\n        let rowObject = {};\n\n        for (let j = 0; j < headers.length; j++) {\n            let headerName = headers[j];\n            let value = currentLine[j] ? currentLine[j].trim() : \"\";\n\n            // Verifica se é a coluna \"minimo\" (independentemente de estar em maiúsculas ou minúsculas)\n            if (headerName.toLowerCase() === 'minimo') {\n                // Troca vírgula por ponto caso o número venha no padrão brasileiro (ex: 1500,50 -> 1500.50)\n                let numeroLimpo = value.replace(',', '.');\n                \n                // Converte explicitamente para Number. Se vier vazio ou inválido, assume 0.\n                rowObject[headerName] = Number(numeroLimpo) || 0;\n            } else {\n                rowObject[headerName] = value;\n            }\n        }\n        \n        // Formato obrigatório do n8n para gerar novos itens no fluxo\n        returnData.push({ json: rowObject });\n    }\n}\n\nreturn returnData;"
      },
